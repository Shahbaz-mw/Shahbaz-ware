trigger: none   # run manually

pool:
  name: 'Default'

variables:
- group: Mobile_dr_sa   # holds storePassword and keyPassword
- name: FLUTTER_VERSION
  value: '3.41.9'
- name: PUB_CACHE
  value: '$(Agent.ToolsDirectory)\pub_cache_$(FLUTTER_VERSION)'
- name: FLUTTER_ROOT_DIR
  value: '$(Agent.ToolsDirectory)\flutter_$(FLUTTER_VERSION)'
- name: FLUTTER_DIR
  value: '$(Agent.ToolsDirectory)\flutter_$(FLUTTER_VERSION)\flutter'
- name: FLUTTER
  value: '$(Agent.ToolsDirectory)\flutter_$(FLUTTER_VERSION)\flutter\bin\flutter.bat'
- name: FLAVOR
  value: 'prod'                      # SET: release flavor (may be 'indiaprod' after the latest commit)
- name: GIT_BRANCH
  value: 'SHV3MultiToolTestServer'   # release branch in mobile_dev
- name: APP_DIR
  value: 'MobileApp/health_worker'
- name: ANDROID_SDK
  value: 'C:\Android\SDK'
- name: JDK17
  value: '$(Agent.ToolsDirectory)\jdk17'
- name: BUILD_NAME
  value: '1.0.0'                     # SET: versionName shown to users
- name: BUILD_NUMBER
  value: '100'                       # SET: must be higher than the current Play versionCode

steps:
- checkout: none

- powershell: |
    if (-not (Get-Command git -ErrorAction SilentlyContinue)) {
      $found = $false
      foreach ($c in @("C:\Program Files\Git\cmd", "C:\Program Files (x86)\Git\cmd", "$env:LOCALAPPDATA\Programs\Git\cmd")) {
        if (Test-Path "$c\git.exe") {
          $env:PATH = "$c;$env:PATH"
          Write-Host "##vso[task.prependpath]$c"
          $found = $true
          break
        }
      }
      if (-not $found) {
        $gitDir = Join-Path "$(Agent.ToolsDirectory)" "mingit"
        if (-not (Test-Path "$gitDir\cmd\git.exe")) {
          Write-Host "Git not found. Downloading portable MinGit..."
          [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
          $zip = Join-Path $env:AGENT_TEMPDIRECTORY "mingit.zip"
          Invoke-WebRequest "https://github.com/git-for-windows/git/releases/download/v2.45.2.windows.1/MinGit-2.45.2-64-bit.zip" -OutFile $zip
          New-Item -ItemType Directory -Force -Path $gitDir | Out-Null
          Expand-Archive $zip -DestinationPath $gitDir -Force
          Remove-Item $zip
        }
        $env:PATH = "$gitDir\cmd;$env:PATH"
        Write-Host "##vso[task.prependpath]$gitDir\cmd"
      }
    }
    git --version

    $dest = "$(Build.SourcesDirectory)"
    $empty = Join-Path $env:AGENT_TEMPDIRECTORY "empty_dir"
    New-Item -ItemType Directory -Force -Path $empty | Out-Null
    New-Item -ItemType Directory -Force -Path $dest | Out-Null
    robocopy $empty $dest /MIR /NFL /NDL /NJH /NJS /NP | Out-Null
    if ($LASTEXITCODE -ge 8) { Write-Error "Cleanup failed ($LASTEXITCODE)"; exit 1 }

    git -c http.extraheader="AUTHORIZATION: bearer $env:SYSTEM_ACCESSTOKEN" clone --depth 1 --branch $(GIT_BRANCH) https://wau-tfs1.tgi.local/tfs/TGI/SHv3/_git/mobile_dev $dest
    if ($LASTEXITCODE -ne 0) { exit 1 }
    git -C $dest log -1 --format="Building commit %H %s"
  displayName: 'Clone mobile_dev ($(GIT_BRANCH))'
  workingDirectory: $(Agent.TempDirectory)
  env:
    SYSTEM_ACCESSTOKEN: $(System.AccessToken)

- powershell: |
    $ProgressPreference = 'SilentlyContinue'
    $dir = "$(FLUTTER_DIR)"
    if (-not (Test-Path "$dir\bin\flutter.bat")) {
      $zip = Join-Path $env:AGENT_TEMPDIRECTORY "flutter_$(FLUTTER_VERSION).zip"
      [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
      Invoke-WebRequest "https://storage.googleapis.com/flutter_infra_release/releases/stable/windows/flutter_windows_$(FLUTTER_VERSION)-stable.zip" -OutFile $zip
      New-Item -ItemType Directory -Force -Path "$(FLUTTER_ROOT_DIR)" | Out-Null
      Expand-Archive $zip -DestinationPath "$(FLUTTER_ROOT_DIR)" -Force
      Remove-Item $zip
    } else { Write-Host "Flutter already installed" }
    git config --global --add safe.directory '*'
    & "$dir\bin\flutter.bat" config --android-sdk "$(ANDROID_SDK)" --no-analytics
    & "$dir\bin\flutter.bat" --version
  displayName: 'Install Flutter $(FLUTTER_VERSION)'

- powershell: |
    $ProgressPreference = 'SilentlyContinue'
    $jdkRoot = "$(JDK17)"
    if (-not (Test-Path "$jdkRoot\bin\java.exe")) {
      [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
      $zip = Join-Path $env:AGENT_TEMPDIRECTORY "jdk17.zip"
      $tmp = Join-Path $env:AGENT_TEMPDIRECTORY "jdk17_extract"
      Invoke-WebRequest "https://api.adoptium.net/v3/binary/latest/17/ga/windows/x64/jdk/hotspot/normal/eclipse" -OutFile $zip
      Remove-Item $tmp -Recurse -Force -ErrorAction SilentlyContinue
      Expand-Archive $zip -DestinationPath $tmp -Force
      Remove-Item $zip
      New-Item -ItemType Directory -Force -Path $jdkRoot | Out-Null
      $inner = Get-ChildItem $tmp -Directory | Select-Object -First 1
      Copy-Item "$($inner.FullName)\*" $jdkRoot -Recurse -Force
      Remove-Item $tmp -Recurse -Force
    }
    & "$jdkRoot\bin\java.exe" -version
  displayName: 'Install JDK 17'

- powershell: |
    Remove-Item "C:\Windows\ServiceProfiles\NetworkService\.gradle\init.d\keep-symbols.gradle" -Force -ErrorAction SilentlyContinue
    Write-Host "=== init scripts remaining ==="
    Get-ChildItem "C:\Windows\ServiceProfiles\NetworkService\.gradle\init.d" -ErrorAction SilentlyContinue
  displayName: 'Make sure no init scripts remain'

- powershell: |
    $sp = $env:STORE_PASS.Replace('\', '\\')
    $kp = $env:KEY_PASS.Replace('\', '\\')
    @"
    storePassword=$sp
    keyPassword=$kp
    keyAlias=upload
    storeFile=../app/upload-keystore.jks
    "@ | Set-Content "$(Build.SourcesDirectory)\$(APP_DIR)\android\key.properties"
  displayName: 'Create key.properties'
  env:
    STORE_PASS: $(storePassword)
    KEY_PASS: $(keyPassword)

- powershell: |
    $ks = "$(Build.SourcesDirectory)\$(APP_DIR)\android\app\upload-keystore.jks"
    Write-Host "Keystore exists: $(Test-Path $ks)"
    & "$(JDK17)\bin\keytool.exe" -list -keystore $ks -storepass "$env:STORE_PASS"
  displayName: 'Verify keystore'
  env:
    STORE_PASS: $(storePassword)

- powershell: |
    if (Test-Path "$(PUB_CACHE)") {
      Remove-Item "$(PUB_CACHE)" -Recurse -Force -ErrorAction SilentlyContinue
      Write-Host "Deleted pub cache $(PUB_CACHE)"
    }
    Remove-Item "$(Build.SourcesDirectory)\$(APP_DIR)\pubspec.lock" -Force -ErrorAction SilentlyContinue
    Remove-Item "$(Build.SourcesDirectory)\$(APP_DIR)\.flutter-plugins" -Force -ErrorAction SilentlyContinue
    Remove-Item "$(Build.SourcesDirectory)\$(APP_DIR)\.flutter-plugins-dependencies" -Force -ErrorAction SilentlyContinue
  displayName: 'Delete pub cache and stale plugin files'

- script: '"$(FLUTTER)" clean'
  workingDirectory: $(APP_DIR)
  displayName: 'flutter clean'

- script: '"$(FLUTTER)" pub get'
  workingDirectory: $(APP_DIR)
  displayName: 'flutter pub get'

- powershell: |
    $a = "$(Build.SourcesDirectory)\$(APP_DIR)"
    Write-Host "=== commit built ==="
    git -C "$(Build.SourcesDirectory)" log -1 --format="%H %s"
    Write-Host "=== firebase_core in cloned pubspec ==="
    Select-String -Path "$a\pubspec.yaml" -Pattern "firebase_core"
    Write-Host "=== productFlavors ==="
    Select-String -Path "$a\android\app\build.gradle" -Pattern "prod|indiaprod|flavorDimensions" -ErrorAction SilentlyContinue
    Write-Host "=== settings.gradle ==="
    Get-Content "$a\android\settings.gradle" -ErrorAction SilentlyContinue
    Get-Content "$a\android\settings.gradle.kts" -ErrorAction SilentlyContinue
    Write-Host "=== gradle-wrapper.properties ==="
    Get-Content "$a\android\gradle\wrapper\gradle-wrapper.properties"
    Write-Host "=== app/build.gradle (first 30 lines) ==="
    Get-Content "$a\android\app\build.gradle" -TotalCount 30 -ErrorAction SilentlyContinue
    Write-Host "=== android/app files (build.gradle and build.gradle.kts both present?) ==="
    Get-ChildItem "$a\android\app" -Filter "build.gradle*" | Select Name
    Write-Host "=== firebase_core in .flutter-plugins-dependencies ==="
    Select-String -Path "$a\.flutter-plugins-dependencies" -Pattern '"name":"firebase_core"' -ErrorAction SilentlyContinue | Select-Object -First 1
  displayName: 'Debug Android setup'
  continueOnError: true

- powershell: |
    $a = "$(Build.SourcesDirectory)\$(APP_DIR)\android"

    # 1. Kotlin 2.1.x -> 2.3.0 in plugin and ext declarations
    foreach ($f in @("$a\settings.gradle","$a\settings.gradle.kts","$a\build.gradle","$a\build.gradle.kts")) {
      if (Test-Path $f) {
        $t = Get-Content $f -Raw
        $n = $t -replace '(org\.jetbrains\.kotlin\.android[^\r\n]*?)2\.1\.\d+', '${1}2.3.0'
        $n = $n -replace '(kotlin_version[^\r\n]*?)2\.1\.\d+', '${1}2.3.0'
        if ($n -ne $t) { Set-Content $f $n; Write-Host "Patched Kotlin version in $f" }
      }
    }

    # 2. NDK version in app/build.gradle
    $f = "$a\app\build.gradle"
    $t = Get-Content $f -Raw
    if ($t -match 'ndkVersion') {
      $n = $t -replace 'ndkVersion\s*=?\s*[^\r\n]+', 'ndkVersion = "28.2.13676358"'
    } else {
      $n = $t -replace '(android\s*\{)', "`$1`n    ndkVersion = `"28.2.13676358`""
    }
    if ($n -ne $t) { Set-Content $f $n; Write-Host "Patched ndkVersion in $f" }

    Write-Host "=== result ==="
    Get-ChildItem $a -Recurse -Include *.gradle,*.kts | Select-String "kotlin.*2\.\d+\.\d+|ndkVersion"
  displayName: 'Patch Kotlin and NDK versions'

- powershell: |
    $a = "$(Build.SourcesDirectory)\$(APP_DIR)\android"
    Write-Host "=== kotlin references in android files ==="
    Get-ChildItem $a -Recurse -Include *.gradle,*.kts,*.properties,*.toml -ErrorAction SilentlyContinue |
      Where-Object { $_.FullName -notmatch '\\build\\' } |
      Select-String -Pattern "kotlin" | Select-Object -First 40
    Write-Host "=== which build files exist ==="
    Get-ChildItem $a -Recurse -Include build.gradle,build.gradle.kts,settings.gradle,settings.gradle.kts,libs.versions.toml -ErrorAction SilentlyContinue |
      Where-Object { $_.FullName -notmatch '\\build\\' } | Select FullName
  displayName: 'Find Kotlin version declarations'
  continueOnError: true

- powershell: |
    Write-Host "=== NDK folders ==="
    Get-ChildItem "$(ANDROID_SDK)\ndk" -Directory -ErrorAction SilentlyContinue | Select Name
    Write-Host "=== flutter doctor ==="
    & "$(FLUTTER)" doctor -v
  displayName: 'Check NDK and toolchain'
  continueOnError: true
  env:
    JAVA_HOME: '$(JDK17)'
    ANDROID_HOME: '$(ANDROID_SDK)'
    ANDROID_SDK_ROOT: '$(ANDROID_SDK)'

- powershell: |
    1..30 | ForEach-Object { 'y' } | & "$(FLUTTER)" doctor --android-licenses
    exit 0
  displayName: 'Accept Android licenses'
  env:
    JAVA_HOME: '$(JDK17)'
    ANDROID_HOME: '$(ANDROID_SDK)'
    ANDROID_SDK_ROOT: '$(ANDROID_SDK)'

- script: '"$(FLUTTER)" build appbundle --release --flavor $(FLAVOR) --build-name=$(BUILD_NAME) --build-number=$(BUILD_NUMBER) --no-tree-shake-icons'
  workingDirectory: $(APP_DIR)
  displayName: 'Build AAB ($(FLAVOR))'
  env:
    JAVA_HOME: '$(JDK17)'
    ANDROID_HOME: '$(ANDROID_SDK)'
    ANDROID_SDK_ROOT: '$(ANDROID_SDK)'

- powershell: |
    Get-ChildItem "$(Build.SourcesDirectory)\$(APP_DIR)\build\app\outputs\bundle" -Recurse -Filter *.aab | Select-Object FullName, Length
  displayName: 'List AAB'

- task: CopyFiles@2
  inputs:
    sourceFolder: '$(Build.SourcesDirectory)/$(APP_DIR)/build/app/outputs/bundle'
    contents: '**/*.aab'
    targetFolder: '$(Build.ArtifactStagingDirectory)'

- task: PublishBuildArtifacts@1
  inputs:
    pathToPublish: '$(Build.ArtifactStagingDirectory)'
    artifactName: 'aab'
