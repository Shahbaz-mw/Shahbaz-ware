
server {
    listen 8080;
    server_name _;

    client_max_body_size 100M;

    # ---------- Upstreams (variables force runtime DNS resolution) ----------
    set $identity_up identityservice:8080;
    set $master_up   master:8080;
    set $dhs_up      dhs:8080;

    # Empty by default -> header is not sent. Prefix locations override it.
    set $fwd_prefix "";

    # ---------- Common proxy settings (inherited by all locations) ----------
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix $fwd_prefix;

    proxy_connect_timeout 60s;
    proxy_send_timeout    60s;
    proxy_read_timeout    60s;

    # ==========================================================
    # GATEWAY
    # ==========================================================
    location = / {
        default_type text/plain;
        return 200 "PCTS Backend Gateway OK\n";
    }

    location = /health {
        default_type text/plain;
        return 200 "PCTS Backend Gateway OK\n";
    }

    # ==========================================================
    # DHS      /dhs/swagger/index.html -> dhs:8080/swagger/index.html
    # ==========================================================
    location = /dhs { return 301 /dhs/; }

    location = /dhs/ {
        rewrite ^ /health/live break;
        proxy_pass http://$dhs_up;
    }

    location ^~ /dhs/ {
        set $fwd_prefix /dhs;
        rewrite ^/dhs/(.*)$ /$1 break;
        proxy_pass http://$dhs_up;
    }

    # ==========================================================
    # IDENTITY /identity/swagger/index.html -> identityservice:8080/swagger/index.html
    # ==========================================================
    location = /identity { return 301 /identity/; }

    location = /identity/ {
        rewrite ^ /health/live break;
        proxy_pass http://$identity_up;
    }

    location ^~ /identity/ {
        set $fwd_prefix /identity;
        rewrite ^/identity/(.*)$ /$1 break;
        proxy_pass http://$identity_up;
    }

    # ==========================================================
    # MASTER   /master/api/<anything> -> master:8080/api/<anything>
    # ==========================================================
    location = /master { return 301 /master/; }

    location = /master/ {
        rewrite ^ /health/live break;
        proxy_pass http://$master_up;
    }

    location ^~ /master/ {
        set $fwd_prefix /master;
        rewrite ^/master/(.*)$ /$1 break;
        proxy_pass http://$master_up;
    }

    # ==========================================================
    # LEGACY (un-prefixed) API ROUTES -> MASTER
    # Regex locations take priority over the /api/ prefix below.
    # Add new master controllers to this list.
    # ==========================================================
    location ~* ^/api/(bankmaster|branchmaster|unitmaster|villageandwardmaster|anganwarimaster|anmmaster|ashamaster)(/|$) {
        proxy_pass http://$master_up;
    }

    # ==========================================================
    # LEGACY (un-prefixed) API ROUTES -> DHS
    # Add new DHS controllers to this list.
    # ==========================================================
    location ~* ^/api/(couplesurvey|janaadhardata)(/|$) {
        proxy_pass http://$dhs_up;
    }

    # ==========================================================
    # EVERYTHING ELSE UNDER /api/ -> IDENTITY (auth, modules, ...)
    # ==========================================================
    location /api/ {
        proxy_pass http://$identity_up;
    }

    # ==========================================================
    # IDENTITY UPLOADED IMAGES
    # ==========================================================
    location /images/ {
        proxy_pass http://$identity_up;
    }
}
